{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "multiple_choice"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "minItems": 2,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "correctAnswer": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "prompt",
              "options",
              "correctAnswer"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "true_false"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "correctAnswer": {
                "type": "boolean"
              },
              "explanation": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "prompt",
              "correctAnswer"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "title",
    "questions"
  ],
  "additionalProperties": false
}
